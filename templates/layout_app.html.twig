{% extends 'base.html.twig' %}

{% block layout %}
{% set route = app.request.attributes.get('_route') ?? '' %}
{% set nav = [
    {prefix: 'app_dashboard', label: 'Tableau de bord', icon: 'query_stats', url: path('app_dashboard')},
    {prefix: 'app_contact',     label: 'Contacts',     icon: 'contacts',   url: path('app_contact_index')},
    {prefix: 'app_opportunity', label: 'Opportunités', icon: 'filter_alt', url: path('app_opportunity_index')},
    {prefix: 'app_task', label: 'Tâches & Relances', icon: 'check_box', url: path('app_task_index')},
    {prefix: 'app_activity', label: "Historique d'échanges", icon: 'forum', url: path('app_activity_index')},
    {prefix: 'app_profile', label: 'Mon profil', icon: 'settings', url: path('app_profile')},
] %}

<aside class="fixed left-0 top-0 bottom-0 w-64 bg-surface-container-lowest border-r border-outline-variant/40 z-50 flex flex-col">
    <a href="{{ path('app_home') }}" class="h-16 px-4 flex items-center gap-2 border-b border-outline-variant/30">
        <div class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center font-bold">F</div>
        <span class="font-headline-sm text-headline-sm text-on-surface">FreelanceCRM</span>
    </a>
    <nav class="flex flex-col gap-1 p-2 mt-2">
        {% for item in nav %}
            {% set active = route starts with item.prefix %}
            <a href="{{ item.url }}"
               class="flex items-center gap-2 px-2 py-2 rounded-lg transition-colors font-label-lg text-label-lg
               {{ active ? 'bg-primary text-on-primary font-medium shadow-sm' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' }}">
                <span class="material-symbols-outlined text-[20px]">{{ item.icon }}</span>
                <span>{{ item.label }}</span>
            </a>
        {% endfor %}
    </nav>
</aside>

<div class="pl-64">
    <header class="fixed top-0 left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-md border-b border-outline-variant/40 z-40 flex items-center justify-end gap-4 px-6">
        {% if app.user %}
            <a href="{{ path('app_profile') }}" class="flex items-center gap-2 p-1 rounded-lg hover:bg-surface-container-high transition-colors">
                <div class="w-8 h-8 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center font-label-md font-semibold">
                    {{ (app.user.firstName|default('?')|first ~ app.user.lastName|default('')|first)|upper }}
                </div>
                <div class="flex flex-col leading-tight">
                    <span class="font-label-lg text-label-lg text-on-surface">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant">{{ app.user.userIdentifier }}</span>
                </div>
            </a>
            <button type="button" data-open-dialog="logout-dialog"
                    class="p-2 rounded-lg text-on-surface-variant hover:bg-surface-container-high" title="Se déconnecter">
                <span class="material-symbols-outlined text-[20px]">logout</span>
            </button>
        {% endif %}
    </header>

    <main class="pt-16 min-h-screen bg-surface">
        <div class="p-6 lg:p-8 max-w-[1400px] mx-auto w-full">
            {% for message in app.flashes('success') %}
                <div class="mb-4 p-3 rounded-lg bg-primary-fixed text-on-primary-fixed font-body-md">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="mb-4 p-3 rounded-lg bg-error-container text-on-error-container font-body-md">{{ message }}</div>
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
    </main>
</div>
{% if app.user %}
<dialog id="logout-dialog" class="w-full max-w-sm rounded-xl p-0 shadow-2xl backdrop:bg-black/40 bg-surface-container-lowest text-on-surface">
    <div class="p-6 text-center">
        <div class="w-12 h-12 rounded-xl bg-error-container text-on-error-container flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined">logout</span>
        </div>
        <h2 class="font-headline-md text-headline-md font-bold text-on-surface">Se déconnecter ?</h2>
        <p class="text-secondary mt-1">Vous devrez vous reconnecter pour retrouver vos contacts.</p>
        <div class="flex gap-2 mt-6">
            <button type="button" data-dialog-close
                    class="flex-1 h-11 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors">
                Annuler
            </button>
            <a href="{{ path('app_logout') }}"
               class="flex-1 h-11 flex items-center justify-center rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-semibold transition-colors">
                Se déconnecter
            </a>
        </div>
    </div>
</dialog>
{% endif %}

<dialog id="quick-contact-dialog" data-url="{{ path('app_contact_quick_new') }}"
        class="w-full max-w-lg rounded-xl p-0 shadow-2xl backdrop:bg-black/40 bg-surface-container-lowest text-on-surface">
    <div data-dialog-body></div>
</dialog>

<script>
// ----- Ouvrir / fermer les modals -----
document.addEventListener('click', (e) => {
    const opener = e.target.closest('[data-open-dialog]');
    if (opener) {
        e.preventDefault();
        document.getElementById(opener.dataset.openDialog)?.showModal();
        return;
    }

    const closer = e.target.closest('[data-dialog-close]');
    if (closer) {
        closer.closest('dialog')?.close();
        return;
    }

    if (e.target instanceof HTMLDialogElement) {
        e.target.close(); // clic sur le fond sombre
    }
});

// ----- Création rapide d'un contact -----
(() => {
    const dialog = document.getElementById('quick-contact-dialog');
    if (!dialog) return;

    const body = dialog.querySelector('[data-dialog-body]');
    let targetSelect = null;

    const loadForm = async () => {
        body.innerHTML = '<p class="p-8 text-center text-on-surface-variant">Chargement…</p>';
        const response = await fetch(dialog.dataset.url);
        body.innerHTML = await response.text();
        body.querySelector('input[type="text"]')?.focus();
    };

    document.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-quick-contact]');
        if (!trigger) return;

        e.preventDefault();
        targetSelect = document.getElementById(trigger.dataset.quickContact);
        dialog.showModal();
        loadForm();
    });

    dialog.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        form.querySelector('[type="submit"]').disabled = true;

        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });

        if (response.status === 201) {
            const contact = await response.json();

            if (targetSelect) {
                targetSelect.add(new Option(contact.label, contact.id, true, true));
                targetSelect.value = String(contact.id);
                targetSelect.dispatchEvent(new Event('change', { bubbles: true }));
            }

            dialog.close();
            return;
        }

        body.innerHTML = await response.text(); // le formulaire, avec ses erreurs
    });
})();
</script>

{% endblock %}