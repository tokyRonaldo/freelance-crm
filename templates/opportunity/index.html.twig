{% extends 'layout_app.html.twig' %}

{% block title %}Opportunités{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Opportunités</h1>
        <p class="text-on-surface-variant">Suivez chaque projet, du premier contact à la signature.</p>
    </div>
    <a href="{{ path('app_opportunity_new') }}" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg shadow-sm transition-colors">
        <span class="material-symbols-outlined text-[18px]">add</span> Nouvelle opportunité
    </a>
</div>

<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-left">
        <thead class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md uppercase tracking-wide">
            <tr>
                <th class="px-4 py-3">Titre</th>
                <th class="px-4 py-3">Contact</th>
                <th class="px-4 py-3 text-right">Montant</th>
                <th class="px-4 py-3">Statut</th>
                <th class="px-4 py-3">Clôture</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-surface-container">
        {% for opportunity in opportunities %}
            <tr class="hover:bg-surface-container-low transition-colors">
                <td class="px-4 py-3 font-medium">
                    <a href="{{ path('app_opportunity_show', {id: opportunity.id}) }}" class="hover:text-primary">{{ opportunity.title }}</a>
                </td>
                <td class="px-4 py-3 text-on-surface-variant">
                    <a href="{{ path('app_contact_show', {id: opportunity.contact.id}) }}" class="hover:text-primary">
                        {{ opportunity.contact.firstName }} {{ opportunity.contact.lastName }}
                    </a>
                </td>
                <td class="px-4 py-3 text-right font-semibold">{{ opportunity.amount|number_format(2, ',', ' ') }} €</td>
                <td class="px-4 py-3">
                    <span class="px-2.5 py-1 rounded-full font-label-sm text-label-sm {{ opportunity.status.badgeClass }}">
                        {{ opportunity.status.label }}
                    </span>
                </td>
                <td class="px-4 py-3 text-on-surface-variant">{{ opportunity.closedAt ? opportunity.closedAt|date('d/m/Y') : '—' }}</td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                    <a href="{{ path('app_opportunity_edit', {id: opportunity.id}) }}" class="text-on-surface-variant hover:text-primary text-sm">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="px-4 py-8 text-center text-on-surface-variant">Aucune opportunité.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}