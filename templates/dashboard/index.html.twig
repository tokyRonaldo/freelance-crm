{% extends 'layout_app.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block content %}
{% set cards = [
    {label: 'Total des contacts', value: kpis.contacts, icon: 'contacts', hint: (kpis.contacts - kpis.prospects) ~ ' client(s)', top: 'bg-primary'},
    {label: 'Prospects', value: kpis.prospects, icon: 'group_add', hint: 'Contacts de type prospect', top: 'bg-secondary-fixed-dim'},
    {label: 'Opportunités ouvertes', value: kpis.openOpportunities, icon: 'filter_alt', hint: 'Pipeline actif', top: 'bg-primary'},
    {label: 'Opportunités gagnées', value: kpis.wonOpportunities, icon: 'verified', hint: 'Projets signés', top: 'bg-primary-container'},
    {label: 'Valeur des opportunités', value: kpis.openValue|number_format(0, ',', ' ') ~ ' €', icon: 'euro', hint: 'Valeur potentielle, pas encaissée', top: 'bg-primary'},
    {label: 'Tâches en retard', value: kpis.overdueTasks, icon: 'notification_important', hint: kpis.overdueTasks > 0 ? 'À traiter en priorité' : 'Tout est à jour', top: 'bg-error', danger: kpis.overdueTasks > 0},
] %}

<div class="mb-6">
    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Tableau de bord</h1>
    <p class="text-on-surface-variant">
        Bienvenue, <span class="font-semibold text-on-surface">{{ app.user.firstName }}</span> — voici l'état de votre activité commerciale.
    </p>
    <p class="mt-1 text-sm {{ overdueCount > 0 ? 'text-error font-medium' : 'text-on-surface-variant' }}">
        {{ overdueCount }} tâche{{ overdueCount > 1 ? 's' : '' }} en retard — {{ todayCount }} prévue{{ todayCount > 1 ? 's' : '' }} aujourd'hui
    </p>
</div>

{# ===== Les 6 indicateurs ===== #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
    {% for card in cards %}
        {% set danger = card.danger|default(false) %}
        <div class="relative overflow-hidden rounded-xl p-4 shadow-sm flex flex-col justify-between {{ danger ? 'bg-error-container/40' : 'bg-surface-container-lowest' }}">
            <div class="absolute top-0 left-0 right-0 h-[3px] {{ card.top }}"></div>
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md font-medium {{ danger ? 'text-error' : 'text-secondary' }}">{{ card.label }}</span>
                <span class="material-symbols-outlined text-[20px] {{ danger ? 'text-error' : 'text-primary' }}">{{ card.icon }}</span>
            </div>
            <div class="my-2 font-headline-lg text-headline-lg font-bold tracking-tight {{ danger ? 'text-error' : 'text-on-surface' }}">{{ card.value }}</div>
            <span class="font-label-sm text-label-sm {{ danger ? 'text-error' : 'text-on-surface-variant' }}">{{ card.hint }}</span>
        </div>
    {% endfor %}
</div>

{# ===== Graphiques ===== #}
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">

    <section class="lg:col-span-5 bg-surface-container-lowest rounded-xl shadow-sm p-6">
        <div class="flex items-center justify-between mb-1">
            <h2 class="font-headline-sm text-headline-sm text-on-surface">Pipeline par statut</h2>
            <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-semibold">
                {{ statusChart.total }} opportunité{{ statusChart.total > 1 ? 's' : '' }}
            </span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-4">Répartition de vos opportunités selon leur avancement.</p>

        {% if statusChart.total > 0 %}
            <div class="relative h-64">
                <canvas id="statusChart" data-chart="{{ statusChart|json_encode|e('html_attr') }}"></canvas>
            </div>
        {% else %}
            <p class="text-on-surface-variant py-10 text-center">Aucune opportunité pour le moment.</p>
        {% endif %}
    </section>

    <section class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-sm p-6">
        <div class="flex items-center justify-between mb-1">
            <h2 class="font-headline-sm text-headline-sm text-on-surface">Opportunités gagnées</h2>
            <span class="px-2 py-0.5 rounded bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm font-semibold">
                {{ wonChart.total }} sur 12 mois
            </span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-4">Nombre de projets signés, mois par mois.</p>

        {% if wonChart.total > 0 %}
            <div class="relative h-64">
                <canvas id="wonChart" data-chart="{{ wonChart|json_encode|e('html_attr') }}"></canvas>
            </div>
        {% else %}
            <p class="text-on-surface-variant py-10 text-center">Aucune opportunité gagnée sur les 12 derniers mois.</p>
        {% endif %}
    </section>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    {# ----- Tâches prioritaires ----- #}
    <section class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-sm p-6">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-outline-variant/30">
            <h2 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-[22px] text-primary">assignment_late</span>
                Relances et tâches prioritaires
            </h2>
            {% if overdueCount > 0 %}
                <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-semibold">
                    {{ overdueCount }} en retard
                </span>
            {% endif %}
        </div>

        <div class="flex flex-col gap-2">
            {% for task in priorityTasks %}
                {{ include('task/_row.html.twig', {task: task}) }}
            {% else %}
                <p class="text-on-surface-variant">Rien d'urgent pour le moment.</p>
            {% endfor %}
        </div>

        <div class="flex items-center justify-between pt-4 mt-4 border-t border-outline-variant/30">
            <a href="{{ path('app_task_new') }}" class="inline-flex items-center gap-1.5 text-primary hover:text-primary-container font-label-md text-label-md font-semibold">
                <span class="material-symbols-outlined text-[16px]">add_task</span> Ajouter une relance
            </a>
            <a href="{{ path('app_task_index') }}" class="text-on-surface-variant hover:underline font-label-sm text-label-sm">Toutes les tâches →</a>
        </div>
    </section>

    {# ----- Activité récente ----- #}
    <section class="lg:col-span-5 bg-surface-container-lowest rounded-xl shadow-sm p-6">
        <div class="flex items-center gap-2 pb-3 mb-4 border-b border-outline-variant/30">
            <span class="material-symbols-outlined text-[22px] text-secondary">history</span>
            <h2 class="font-headline-sm text-headline-sm text-on-surface">Activités récentes</h2>
        </div>

        {% if events|length > 0 %}
            <div class="relative flex flex-col gap-5 pl-4 before:content-[''] before:absolute before:left-1.5 before:top-2 before:bottom-2 before:w-0.5 before:bg-outline-variant/40">
                {% for event in events %}
                    <div class="relative">
                        <div class="absolute -left-4 mt-1 w-3 h-3 rounded-full bg-primary ring-4 ring-surface-container-lowest"></div>
                        <span class="block font-label-md text-label-md text-on-surface font-semibold">{{ event.title }}</span>
                        <a href="{{ path(event.route, event.params) }}" class="block text-body-sm text-on-surface-variant hover:text-primary">{{ event.text }}</a>
                        <span class="block font-label-sm text-label-sm text-outline mt-0.5">{{ event.at|date('d/m/Y à H:i') }}</span>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-on-surface-variant">Aucune activité pour le moment.</p>
        {% endif %}
    </section>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    Chart.defaults.font.family = 'Inter, sans-serif';
    Chart.defaults.color = '#3d4a42';

    const statusEl = document.getElementById('statusChart');
    if (statusEl) {
        const d = JSON.parse(statusEl.dataset.chart);
        new Chart(statusEl, {
            type: 'doughnut',
            data: {
                labels: d.labels,
                datasets: [{ data: d.values, backgroundColor: d.colors, borderWidth: 0 }],
            },
            options: {
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } } },
            },
        });
    }

    const wonEl = document.getElementById('wonChart');
    if (wonEl) {
        const d = JSON.parse(wonEl.dataset.chart);
        new Chart(wonEl, {
            type: 'bar',
            data: {
                labels: d.labels,
                datasets: [{ label: 'Gagnées', data: d.values, backgroundColor: '#006948', borderRadius: 6 }],
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(188, 202, 192, 0.4)' } },
                    x: { grid: { display: false } },
                },
            },
        });
    }
});
</script>
{% endblock %}