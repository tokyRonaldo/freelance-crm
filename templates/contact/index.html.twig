{% extends 'layout_app.html.twig' %}

{% block title %}Contacts{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Contacts</h1>
        <p class="text-on-surface-variant">Vos prospects et vos clients au même endroit.</p>
    </div>
    <a href="{{ path('app_contact_new') }}" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg shadow-sm transition-colors">
        <span class="material-symbols-outlined text-[18px]">add</span> Nouveau contact
    </a>
</div>

<form method="get" class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
    <input type="text" name="q" value="{{ search }}" placeholder="Rechercher par nom, entreprise ou e-mail"
           class="md:col-span-6 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none">
    <select name="type" class="md:col-span-3 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none">
        <option value="">Tous les types</option>
        <option value="prospect" {{ type == 'prospect' ? 'selected' : '' }}>Prospect</option>
        <option value="client" {{ type == 'client' ? 'selected' : '' }}>Client</option>
    </select>
    <div class="md:col-span-3 flex items-center gap-2">
        <button class="px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors">Filtrer</button>
        <a href="{{ path('app_contact_index') }}" class="text-sm text-primary hover:underline">Réinitialiser</a>
    </div>
</form>

<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-left">
        <thead class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md uppercase tracking-wide">
            <tr>
                <th class="px-4 py-3">Nom</th>
                <th class="px-4 py-3">Entreprise</th>
                <th class="px-4 py-3">E-mail</th>
                <th class="px-4 py-3">Type</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-surface-container">
        {% for contact in pagination %}
            <tr class="hover:bg-surface-container-low transition-colors">
                <td class="px-4 py-3">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center font-label-md font-semibold">
                            {{ (contact.firstName|default('')|first ~ contact.lastName|first)|upper }}
                        </div>
                        <a href="{{ path('app_contact_show', {id: contact.id}) }}" class="font-medium text-on-surface hover:text-primary">
                            {{ contact.firstName }} {{ contact.lastName }}
                        </a>
                    </div>
                </td>
                <td class="px-4 py-3 text-on-surface-variant">{{ contact.company }}</td>
                <td class="px-4 py-3 text-on-surface-variant">{{ contact.email }}</td>
                <td class="px-4 py-3">
                    <span class="px-2.5 py-1 rounded-full font-label-sm text-label-sm {{ contact.type == 'client' ? 'bg-primary-fixed text-on-primary-fixed' : 'bg-secondary-container text-on-secondary-container' }}">
                        {{ contact.type|capitalize }}
                    </span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                    <a href="{{ path('app_contact_show', {id: contact.id}) }}"
                    class="inline-flex items-center p-1.5 rounded-lg text-primary hover:bg-primary-container"
                    title="Voir">
                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                    </a>

                    <a href="{{ path('app_contact_edit', {id: contact.id}) }}"
                    class="inline-flex items-center p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-primary"
                    title="Modifier">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="px-4 py-8 text-center text-on-surface-variant">Aucun contact trouvé.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-4">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}