{% extends 'layout_app.html.twig' %}

{% block title %}Nouveau contact{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto">
    <nav class="flex items-center gap-1 text-label-md font-label-md text-secondary mb-4">
        <a href="{{ path('app_contact_index') }}" class="hover:text-primary flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">group</span> Contacts
        </a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <span class="text-on-surface font-semibold">Nouveau contact</span>
    </nav>
    {{ include('contact/_form.html.twig', {
        title: 'Ajouter un contact',
        subtitle: 'Enregistrez un nouveau prospect ou client en quelques secondes.',
        icon: 'person_add',
        cancel_url: path('app_contact_index'),
        button_label: 'Enregistrer le contact'
    }) }}
</div>
{% endblock %}