<form method="post" action="{{ path('app_contact_delete', {id: contact.id}) }}" onsubmit="return confirm('Supprimer ce contact ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
    <button class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-error-container text-on-error-container hover:opacity-90 font-label-lg text-label-lg transition-opacity">
        <span class="material-symbols-outlined text-[18px]">delete</span> Supprimer
    </button>
</form>