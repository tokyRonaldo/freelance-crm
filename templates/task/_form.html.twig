{% form_theme form with ['form_div_layout.html.twig'] only %}
{% import 'form/_ui.html.twig' as ui %}

{{ form_start(form, {attr: {class: 'flex flex-col gap-6'}}) }}
<div class="bg-surface-container-lowest rounded-xl shadow-sm p-6 md:p-10 flex flex-col gap-6">

    <div class="flex items-center gap-3 pb-2">
        <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[24px]">{{ icon|default('check_box') }}</span>
        </div>
        <div>
            <h1 class="font-headline-md text-headline-md font-bold text-on-surface">{{ title }}</h1>
            <p class="text-secondary">{{ subtitle|default('') }}</p>
        </div>
    </div>

    {{ ui.field(form.title, 'Titre', 'task_alt', 'ex : Relancer Jean Dupont', null) }}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {{ ui.select(form.contact, 'Contact associé', 'person', 'Optionnel') }}
        {{ ui.select(form.opportunity, 'Opportunité associée', 'monetization_on', 'Optionnel') }}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {{ ui.field(form.dueAt, "Date d'échéance", 'event', null, null) }}
        {{ ui.select(form.priority, 'Priorité', 'flag', null) }}
        {{ ui.select(form.status, 'Statut', 'tune', null) }}
    </div>

    <div class="flex flex-col gap-1.5">
        <label for="{{ form.description.vars.id }}" class="flex items-center justify-between font-label-md text-label-md font-medium text-on-surface">
            <span>Description</span>
            <span class="font-label-sm text-label-sm text-secondary font-normal">Optionnel</span>
        </label>
        {{ form_widget(form.description, {attr: {rows: 3, placeholder: 'Ex : demander un retour sur la proposition', class: 'w-full p-3.5 border-0 bg-surface-container-low text-on-surface rounded-lg text-sm placeholder-secondary/60 resize-y min-h-[90px] focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/25 transition-all'}}) }}
    </div>

    <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-2 pt-2">
        <a href="{{ cancel_url }}" class="w-full sm:w-auto h-11 px-6 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors">Annuler</a>
        <button type="submit" class="w-full sm:w-auto h-11 px-8 inline-flex items-center justify-center gap-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md shadow-sm transition-colors">
            <span class="material-symbols-outlined text-[18px]">save</span>
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
</div>
{{ form_end(form) }}