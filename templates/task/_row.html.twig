{% set done = task.status.name == 'Done' %}
<div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low {{ done ? 'opacity-70' : '' }}">
    <form method="post" action="{{ path('app_task_toggle', {id: task.id}) }}" class="shrink-0">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ task.id) }}">
        <input type="hidden" name="_back" value="{{ app.request.requestUri }}">
        <button type="submit" title="{{ done ? 'Rouvrir' : 'Marquer comme terminée' }}"
                class="flex items-center justify-center text-primary hover:text-primary-container transition-colors">
            <span class="material-symbols-outlined text-[24px]" {{ done ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>
                {{ done ? 'check_circle' : 'radio_button_unchecked' }}
            </span>
        </button>
    </form>

    <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ path('app_task_edit', {id: task.id}) }}"
               class="font-label-lg text-label-lg text-on-surface hover:text-primary {{ done ? 'line-through' : '' }}">{{ task.title }}</a>
            <span class="px-2 py-0.5 rounded-full font-label-sm text-label-sm {{ task.priority.badgeClass }}">{{ task.priority.label }}</span>
            {% if task.status.name == 'InProgress' %}
                <span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed-variant font-label-sm text-label-sm">En cours</span>
            {% endif %}
        </div>
        <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-body-sm text-secondary">
            {% if show_contact|default(true) and task.contact %}
                <a href="{{ path('app_contact_show', {id: task.contact.id}) }}" class="inline-flex items-center gap-1 hover:text-primary">
                    <span class="material-symbols-outlined text-[14px]">person</span>
                    {{ task.contact.firstName }} {{ task.contact.lastName }}
                </a>
            {% endif %}
            {% if task.opportunity %}
                <span class="inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">monetization_on</span> {{ task.opportunity.title }}
                </span>
            {% endif %}
        </div>
    </div>

    <span class="shrink-0 font-label-md text-label-md {{ task.isOverdue ? 'text-error font-semibold' : 'text-on-surface-variant' }}">
        {% if done %}Terminée le {{ task.completedAt|date('d/m') }}{% else %}{{ task.dueAt|date('d/m/Y') }}{% endif %}
    </span>

    <div class="shrink-0 flex items-center gap-1">
        <a href="{{ path('app_task_edit', {id: task.id}) }}" class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high" title="Modifier">
            <span class="material-symbols-outlined text-[18px]">edit</span>
        </a>
        <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" onsubmit="return confirm('Supprimer cette tâche ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
            <input type="hidden" name="_back" value="{{ app.request.requestUri }}">
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-error-container hover:text-on-error-container" title="Supprimer">
                <span class="material-symbols-outlined text-[18px]">delete</span>
            </button>
        </form>
    </div>
</div>