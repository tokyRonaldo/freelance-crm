{% macro field(f, label, icon, placeholder, hint) %}
    {% set input = 'w-full h-11 border-0 bg-surface-container-low text-on-surface rounded-lg text-sm placeholder-secondary/60 focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/25 transition-all ' ~ (icon ? 'pl-9 pr-3.5' : 'px-3.5') %}
    <div class="flex flex-col gap-1.5">
        <label for="{{ f.vars.id }}" class="flex items-center justify-between font-label-md text-label-md font-medium text-on-surface">
            <span>{{ label }}{% if f.vars.required %}<span class="text-error ml-1 font-bold">*</span>{% endif %}</span>
            {% if hint %}<span class="font-label-sm text-label-sm text-secondary font-normal">{{ hint }}</span>{% endif %}
        </label>
        <div class="relative">
            {% if icon %}<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">{{ icon }}</span>{% endif %}
            {{ form_widget(f, {attr: {class: input, placeholder: placeholder}}) }}
        </div>
        {% for error in f.vars.errors %}<p class="text-sm text-error">{{ error.message }}</p>{% endfor %}
    </div>
{% endmacro %}

{% macro select(f, label, icon, hint) %}
    <div class="flex flex-col gap-1.5">
        <label for="{{ f.vars.id }}" class="flex items-center justify-between font-label-md text-label-md font-medium text-on-surface">
            <span>{{ label }}{% if f.vars.required %}<span class="text-error ml-1 font-bold">*</span>{% endif %}</span>
            {% if hint %}{{ hint|raw }}{% endif %}
        </label>
        <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">{{ icon }}</span>
            {{ form_widget(f, {attr: {class: 'w-full h-11 border-0 bg-none pl-9 pr-8 bg-surface-container-low text-on-surface rounded-lg text-sm appearance-none cursor-pointer focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/25 transition-all'}}) }}
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[18px]">expand_more</span>
        </div>
        {% for error in f.vars.errors %}<p class="text-sm text-error">{{ error.message }}</p>{% endfor %}
    </div>
{% endmacro %}